<Layouts.app flash={@flash} current_scope={@current_scope} wide>
  <header class="mb-9 flex items-center justify-between border-b border-white/10 pb-6">
    <div>
      <p class="text-xs uppercase tracking-[0.2em] text-teal-300">Sentinel · Historial</p>
      <h1 class="mt-2 text-3xl font-semibold tracking-tight">Cruces de personas</h1>
    </div>
    <.link
      id="back-cameras"
      navigate={~p"/cameras"}
      class="rounded-lg border border-white/10 px-4 py-2 text-sm transition hover:bg-white/5"
    >Ver cámaras</.link>
    <.link
      id="catalog-from-history"
      navigate={~p"/cameras/catalog"}
      class="rounded-lg px-3 py-2 text-sm text-teal-200"
    >Administrar canales</.link>
  </header>
  <p class="mb-6 max-w-3xl text-sm leading-6 text-slate-400">
    Cada registro representa un cruce, no una persona única. Fechas y horas de Ciudad de México (CST). Los totales incluyen solo los eventos guardados; revisa las pérdidas en la configuración de cada cámara.
  </p>
  <section
    :if={@event}
    id="passage-detail"
    class="mb-8 rounded-2xl border border-teal-300/20 bg-slate-900 p-5"
  >
    <.link
      id="visitor-close-detail"
      patch={history_path(@url_params)}
      class="mb-4 inline-flex items-center gap-2 text-sm text-teal-200 hover:text-teal-100"
    ><.icon name="hero-arrow-left" class="size-4" /> Volver a las imágenes</.link>
    <h2 class="mb-3 font-semibold">
      Evento #{@event.id} · {get_in(@camera_metadata, [@event.camera_id, :label]) ||
        @event.camera_id} · {@event.direction}
    </h2>
    <span class="mb-3 inline-flex items-center gap-2 text-sm text-slate-300"><span
      class="size-3 rounded-full"
      style={"background-color: #{channel_color(get_in(@camera_metadata, [@event.camera_id, :color]))}"}
      aria-hidden="true"
    ></span>{get_in(@camera_metadata, [@event.camera_id, :branch]) || "Canal"}</span>
    <img
      src={"/visitors/events/#{@event.id}/snapshot"}
      alt="Captura del cruce"
      class="max-h-[80vh] w-full rounded-xl bg-black object-contain"
    />
    <.snapshot_provenance event={@event} detail />
    <p class="mt-3 text-sm text-slate-400">Confianza: {round(@event.confidence * 100)}%</p>
  </section>
  <nav class="mb-5 flex gap-2" aria-label="Modo del historial">
    <.link
      id="visitor-mode-daily"
      patch={mode_path(@url_params, "daily")}
      aria-current={if @filters.mode == "daily", do: "page"}
      class="rounded-lg border border-teal-300/30 px-4 py-2 text-sm text-teal-200 transition hover:bg-teal-300/10"
    >Actividad diaria</.link>
    <.link
      id="visitor-mode-range"
      patch={mode_path(@url_params, "range")}
      aria-current={if @filters.mode == "range", do: "page"}
      class="rounded-lg border border-white/10 px-4 py-2 text-sm transition hover:bg-white/5"
    >Rango de fechas</.link>
  </nav>
  <.form
    for={@form}
    id="visitor-filters"
    phx-submit="filter"
    class="mb-7 grid gap-4 rounded-2xl border border-white/10 bg-slate-900 p-5 sm:grid-cols-2 lg:grid-cols-5"
  >
    <.input field={@form[:mode]} type="hidden" />
    <.input :if={@filters.mode == "daily"} field={@form[:from]} type="hidden" />
    <.input :if={@filters.mode == "daily"} field={@form[:until]} type="hidden" />
    <.input :if={@filters.mode == "range"} field={@form[:day]} type="hidden" />
    <.input
      :if={@filters.mode == "daily"}
      field={@form[:day]}
      type="date"
      label="Día (CST)"
      class="mt-2 block w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-sm text-slate-100"
    />
    <.input
      field={@form[:camera_id]}
      type="select"
      label="Cámara"
      options={@camera_options}
      class="mt-2 block w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-sm text-slate-100"
    />
    <.input
      :if={@filters.mode == "range"}
      field={@form[:from]}
      type="date"
      label="Desde (CST)"
      class="mt-2 block w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-sm text-slate-100"
    />
    <.input
      :if={@filters.mode == "range"}
      field={@form[:until]}
      type="date"
      label="Hasta (CST)"
      class="mt-2 block w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-sm text-slate-100"
    />
    <.input
      field={@form[:direction]}
      type="select"
      label="Dirección"
      options={[{"Ambas", ""}, {"Entrada", "entry"}, {"Salida", "exit"}]}
      class="mt-2 block w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-sm text-slate-100"
    />
    <button
      id="apply-visitor-filters"
      class="self-end rounded-lg bg-teal-300 px-4 py-2 font-medium text-slate-950 transition hover:bg-teal-200"
      phx-disable-with="Consultando…"
    >Consultar</button>
  </.form>
  <p
    :if={@filters.camera_id != ""}
    class="-mt-4 mb-6 inline-flex items-center gap-2 text-xs text-slate-400"
    id="selected-channel-color"
  >
    <span
      class="size-2.5 rounded-full"
      style={"background-color: #{channel_color(get_in(@camera_metadata, [@filters.camera_id, :color]))}"}
      aria-hidden="true"
    ></span>
    Canal seleccionado: {get_in(@camera_metadata, [@filters.camera_id, :label]) ||
      @filters.camera_id}
  </p>
  <div class="mb-7 grid grid-cols-2 gap-4">
    <div id="entry-total" class="rounded-2xl border border-white/10 bg-slate-900 p-5">
      <p class="text-sm text-slate-400">Entradas guardadas</p><p class="mt-2 text-4xl font-semibold tabular-nums text-teal-300">
        {@totals.entry}
      </p>
    </div>
    <div id="exit-total" class="rounded-2xl border border-white/10 bg-slate-900 p-5">
      <p class="text-sm text-slate-400">Salidas guardadas</p><p class="mt-2 text-4xl font-semibold tabular-nums">
        {@totals.exit}
      </p>
    </div>
  </div>
  <p :if={@loading?} id="visitor-loading" role="status" class="mb-4 text-sm text-teal-200">
    Consultando actividad…
  </p>
  <div
    :if={@query_error?}
    id="visitor-query-error"
    role="alert"
    class="mb-5 rounded-xl border border-rose-300/30 p-4 text-sm text-rose-200"
  >
    No se pudo consultar el historial.
    <button id="visitor-retry" phx-click="retry" class="underline">Reintentar</button>
  </div>
  <p
    :if={@selection_notice?}
    id="visitor-selection-notice"
    role="status"
    class="mb-4 text-sm text-amber-200"
  >
    La selección cambió o ya no está disponible. Mostramos el día completo.
  </p>
  <section
    :if={@filters.mode == "daily"}
    id="daily-timeline"
    class="mb-8 rounded-2xl border border-white/10 bg-slate-900 p-4 sm:p-6"
    aria-label="Actividad de imágenes del día CST"
  >
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div>
        <h2 class="font-semibold">Actividad del {@filters.day}</h2><p class="mt-1 text-xs text-slate-400">
          {@image_count} imágenes · {@group_count} grupos · intervalos de 5 minutos · CST
        </p>
      </div>
      <button
        :if={@selection}
        id="visitor-reset-selection"
        phx-click="reset_selection"
        class="rounded-lg border border-teal-300/30 px-3 py-2 text-sm text-teal-200 transition hover:bg-teal-300/10"
      >Ver todo el día</button>
    </div>
    <div class="mt-6 overflow-x-auto pb-2">
      <div
        id="visitor-density"
        class="grid h-20 min-w-[720px] items-end gap-px"
        style="grid-template-columns: repeat(288, minmax(0, 1fr))"
        role="group"
        aria-label="Densidad de imágenes cada cinco minutos; también puedes usar la lista de grupos"
      >
        <button
          :for={bin <- @bins}
          id={"density-bin-#{bin.id}"}
          phx-click="select_bin"
          phx-value-id={bin.id}
          aria-label={bin_description(bin, @camera_metadata)}
          aria-pressed={to_string(selected_bin?(@selection, bin.id))}
          title={"#{bin_time(bin.id)} · #{bin.count} imágenes"}
          style={"height: #{max(4, div(bin.count * 100, @peak))}%"}
          class={[
            "min-h-1 rounded-t-sm transition hover:bg-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-200",
            if(bin.count == 0, do: "bg-slate-700", else: "bg-teal-300"),
            selected_bin?(@selection, bin.id) && "ring-2 ring-white"
          ]}
        >
          <span
            class="flex h-full w-full flex-col-reverse overflow-hidden rounded-t-sm"
            aria-hidden="true"
          >
            <span
              :for={segment <- bin.cameras}
              style={"height: #{max(1, div(segment.count * 100, max(bin.count, 1)))}%; background-color: #{channel_color(get_in(@camera_metadata, [segment.camera_id, :color]))}"}
            ></span>
          </span>
        </button>
      </div>
      <ul
        :if={map_size(@camera_metadata) > 0}
        id="timeline-camera-legend"
        class="mt-3 flex flex-wrap gap-x-4 gap-y-2 text-xs text-slate-400"
        aria-label="Leyenda de cámaras"
      >
        <li :for={{camera_id, metadata} <- @camera_metadata} class="flex items-center gap-2">
          <span
            class="size-2.5 rounded-full"
            style={"background-color: #{channel_color(metadata.color)}"}
            aria-hidden="true"
          ></span>{metadata.label} · {camera_id}
        </li>
      </ul>
      <div class="mt-2 flex min-w-[720px] justify-between text-[10px] tabular-nums text-slate-500">
        <span>00:00</span><span>06:00</span><span>12:00</span><span>18:00</span><span>24:00 CST</span>
      </div>
    </div>
    <p class="mt-2 text-xs text-slate-500">
      Las franjas grises indican periodos sin imágenes. Un grupo empieza tras más de 120 segundos sin actividad de esa cámara.
    </p>
    <div
      id="visitor-groups"
      phx-update="stream"
      class="mt-5 grid gap-2 sm:grid-cols-2 lg:grid-cols-3"
    >
      <p
        id="visitor-groups-empty"
        class="col-span-full hidden py-6 text-center text-sm text-slate-500 only:block"
      >
        No hay grupos en este día.
      </p>
      <div :for={{dom_id, group} <- @streams.groups} id={dom_id}>
        <button
          id={"visitor-group-#{group.id}"}
          phx-click="select_group"
          phx-value-id={group.id}
          aria-pressed={to_string(selected_group?(@selection, group.id))}
          class={[
            "w-full rounded-xl border p-3 text-left transition hover:bg-white/5 focus-visible:outline-2 focus-visible:outline-teal-200",
            if(selected_group?(@selection, group.id),
              do: "border-teal-300 bg-teal-300/10",
              else: "border-white/10"
            )
          ]}
        >
          <span class="block text-sm font-medium text-teal-200"><span
            class="mr-2 inline-block size-2.5 rounded-full"
            style={"background-color: #{channel_color(get_in(@camera_metadata, [group.camera_id, :color]))}"}
            aria-hidden="true"
          ></span>{get_in(@camera_metadata, [
            group.camera_id,
            :label
          ]) || group.camera_id} · {group.image_count} imágenes</span><span class="mt-1 block text-xs tabular-nums text-slate-400">{Sentinel.LocalTime.format(
            group.started_at,
            "%H:%M:%S"
          )}–{Sentinel.LocalTime.format(group.ended_at, "%H:%M:%S")} CST</span>
        </button>
      </div>
    </div>
    <nav
      :if={@group_count > 24}
      class="mt-4 flex items-center justify-center gap-3 text-sm"
      aria-label="Páginas de grupos"
    >
      <button
        id="visitor-groups-previous"
        phx-click="group_page"
        phx-value-direction="previous"
        disabled={@group_page == 1}
        class="rounded-lg px-3 py-2 hover:bg-white/5 disabled:opacity-30"
      >Anteriores</button>
      <span>Grupos · página {@group_page}</span>
      <button
        id="visitor-groups-next"
        phx-click="group_page"
        phx-value-direction="next"
        disabled={@group_page * 24 >= @group_count}
        class="rounded-lg px-3 py-2 hover:bg-white/5 disabled:opacity-30"
      >Siguientes</button>
    </nav>
  </section>
  <div id="passage-events" phx-update="stream" class="grid gap-5 sm:grid-cols-2 xl:grid-cols-4">
    <p
      :if={!@loading? and !@query_error?}
      id="passage-empty"
      class="col-span-full hidden rounded-2xl border border-dashed border-slate-700 p-12 text-center text-slate-500 only:block"
    >
      No hay cruces guardados para este periodo.
    </p>
    <article
      :for={{id, event} <- @streams.events}
      id={id}
      class="overflow-hidden rounded-2xl border border-white/10 bg-slate-900 transition hover:border-teal-300/30"
    >
      <.link patch={detail_path(@url_params, event.id)} id={"passage-link-#{event.id}"}>
        <img
          src={"/visitors/events/#{event.id}/snapshot"}
          loading="lazy"
          alt={"Cruce de #{event.camera_id}"}
          class="aspect-video w-full object-contain bg-black"
        />
        <div class="p-4">
          <p class="inline-flex items-center gap-2 text-xs font-medium text-teal-300">
            <span
              class="size-2.5 rounded-full"
              style={"background-color: #{channel_color(get_in(@camera_metadata, [event.camera_id, :color]))}"}
              aria-hidden="true"
            ></span>
            {get_in(@camera_metadata, [event.camera_id, :label]) || event.camera_id} · {if event.direction ==
                                                                                             "entry",
                                                                                           do:
                                                                                             "Entrada",
                                                                                           else:
                                                                                             "Salida"}
          </p><p class="mt-2 text-sm">{Sentinel.LocalTime.format(event.crossed_at)} CST</p><p class="mt-1 text-xs text-slate-500">
            Confianza {round(event.confidence * 100)}%
          </p>
          <.snapshot_provenance event={event} />
        </div>
      </.link>
    </article>
  </div>
  <nav class="mt-7 flex items-center justify-center gap-4" aria-label="Páginas del historial">
    <button
      id="visitor-previous"
      phx-click="page"
      phx-value-direction="previous"
      disabled={@page == 1}
      class="rounded-lg border border-white/10 px-4 py-2 text-sm transition hover:bg-white/5 disabled:opacity-30"
    >Anterior</button>
    <span id="visitor-page" class="text-sm tabular-nums text-slate-400">Página {@page}</span>
    <button
      id="visitor-next"
      phx-click="page"
      phx-value-direction="next"
      disabled={@count < 24}
      class="rounded-lg border border-white/10 px-4 py-2 text-sm transition hover:bg-white/5 disabled:opacity-30"
    >Siguiente</button>
  </nav>
</Layouts.app>
