<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div>
    <.section_header
      id="catalog-heading"
      section="Configuración local"
      title="Catálogo de canales"
    >
      <:actions>
        <.link
          id="catalog-back-cameras"
          navigate={~p"/cameras"}
          class="rounded-lg px-4 py-2 text-sm text-teal-300 hover:bg-teal-300/10"
        >Volver a cámaras</.link>
      </:actions>
    </.section_header>

    <.form
      for={@form}
      id="camera-catalog-form"
      phx-change="validate"
      phx-submit="save"
      class="mb-10 grid gap-4 rounded-2xl border border-white/10 bg-slate-900 p-6 sm:grid-cols-2"
    >
      <h2 class="sm:col-span-2 text-lg font-semibold">
        {editor_title(@editing_id)}
      </h2>
      <.input field={@form[:id]} label="ID estable" readonly={!!@editing_id} />
      <.input field={@form[:branch]} id="catalog-camera-branch" label="Sucursal" />
      <.input field={@form[:label]} label="Etiqueta" />
      <.input
        field={@form[:color]}
        type="select"
        label="Color"
        options={Enum.map(@colors, &{String.capitalize(&1), &1})}
      />
      <.input
        field={@form[:principal]}
        type="password"
        autocomplete="new-password"
        label="RTSP principal (vacío conserva el valor)"
      />
      <.input
        field={@form[:secundaria]}
        type="password"
        autocomplete="new-password"
        label="RTSP secundaria (vacío conserva el valor)"
      />
      <div class="sm:col-span-2 flex flex-wrap gap-3">
        <button
          id="save-camera"
          type="submit"
          phx-disable-with="Guardando…"
          class="rounded-lg bg-teal-300 px-4 py-2 font-medium text-slate-950"
        >Guardar canal</button>
        <button
          :if={@editing_id}
          type="button"
          phx-click={JS.push("new") |> JS.focus(to: "#edit-camera-#{@editing_id}")}
          class="rounded-lg border border-white/10 px-4 py-2"
        >Cancelar</button>
      </div>
    </.form>

    <section class="space-y-3" aria-label="Canales registrados">
      <article
        :for={entry <- @cameras}
        id={"catalog-camera-#{entry.camera.id}"}
        class="flex flex-wrap items-center justify-between gap-4 rounded-xl border border-white/10 bg-slate-900 p-4"
      >
        <div class="flex min-w-0 items-center gap-3 break-words">
          <div>
            <p class="font-medium">
              <.channel_label color={entry.camera.color}>
                {entry.camera.label} · {entry.camera.id}
              </.channel_label>
            </p>
            <p class="flex flex-wrap items-center gap-2 text-xs text-slate-500">
              <span class={counting_badge_class(entry)}>{counting_text(entry)}</span>
              <span>Última captura {last_capture_text(entry.last_capture)}</span>
            </p>
            <p class="text-sm text-slate-400">
              {entry.camera.branch} · Principal {source_text(entry.sources, "principal")} · Secundaria {source_text(
                entry.sources,
                "secundaria"
              )}
            </p>
          </div>
          <span :if={entry.camera.archived_at} class="text-xs text-amber-300">Archivada</span>
        </div>
        <div class="flex gap-2">
          <button
            :if={!entry.camera.archived_at}
            id={"edit-camera-#{entry.camera.id}"}
            phx-click={JS.push("edit") |> JS.focus(to: "#catalog-camera-branch")}
            phx-value-id={entry.camera.id}
            class="rounded-lg border border-white/10 px-3 py-2 text-sm"
          >Editar</button>
          <button
            :if={!entry.camera.archived_at}
            phx-click="archive"
            data-confirm="¿Archivar este canal? Se detendrá su conteo y se conservará el historial."
            phx-value-id={entry.camera.id}
            class="rounded-lg border border-white/10 px-3 py-2 text-sm"
          >Archivar</button>
          <button
            :if={entry.camera.archived_at}
            phx-click="restore"
            phx-value-id={entry.camera.id}
            class="rounded-lg border border-white/10 px-3 py-2 text-sm"
          >Restaurar</button>
        </div>
      </article>
    </section>
  </div>
</Layouts.app>
