<Layouts.app flash={@flash}>
  <.section_header id="home-heading" section="Inicio" title="Sentinel" />
  <p class="mb-8 max-w-2xl text-base leading-7 text-slate-400">
    Tu espacio para observar sucursales, consultar cruces de personas y administrar canales de monitoreo.
  </p>
  <nav id="home-navigation" class="grid gap-5 sm:grid-cols-2" aria-label="Secciones de Sentinel">
    <.link
      id="home-cameras"
      navigate={~p"/cameras"}
      class="group rounded-2xl border border-white/10 bg-slate-900 p-6 transition hover:border-teal-300/40 hover:bg-slate-800"
    >
      <.icon name="hero-video-camera" class="mb-5 size-7 text-teal-300" />
      <h2 class="text-lg font-semibold">Cámaras</h2>
      <p class="mt-2 text-sm leading-6 text-slate-400">
        Observa tus sucursales y elige los canales que quieres ver.
      </p>
    </.link>
    <.link
      :if={@visitor_access?}
      id="home-history"
      navigate={~p"/visitors"}
      class="rounded-2xl border border-white/10 bg-slate-900 p-6 transition hover:border-teal-300/40 hover:bg-slate-800"
    >
      <.icon name="hero-clock" class="mb-5 size-7 text-teal-300" />
      <h2 class="text-lg font-semibold">Historial de cruces</h2>
      <p class="mt-2 text-sm leading-6 text-slate-400">
        Consulta la actividad y las capturas de cada canal.
      </p>
    </.link>
    <.link
      :if={@visitor_access?}
      id="home-catalog"
      navigate={~p"/cameras/catalog"}
      class="rounded-2xl border border-white/10 bg-slate-900 p-6 transition hover:border-teal-300/40 hover:bg-slate-800"
    >
      <.icon name="hero-adjustments-horizontal" class="mb-5 size-7 text-teal-300" />
      <h2 class="text-lg font-semibold">Administrar canales</h2>
      <p class="mt-2 text-sm leading-6 text-slate-400">
        Configura las cámaras y conserva su historial.
      </p>
    </.link>
  </nav>
</Layouts.app>
